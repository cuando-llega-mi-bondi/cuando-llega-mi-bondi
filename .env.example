# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only (SIN prefijo NEXT_PUBLIC — nunca al cliente). Project Settings →
# API → service_role. La usa app/api/account/delete para borrar la cuenta y
# anonimizar sus reseñas; sin esto, "Eliminar cuenta" falla en producción.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Telegram Bot ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your-bot-username

# ─── MGP Proxy ──────────────────────────────────────────────
MGP_PROXY_URL=https://proxy.example.com
MGP_PROXY_TOKEN=your-proxy-token

# ─── MGP Oracle ─────────────────────────────────────────────
MGP_ORACLE_URL=https://oracle.example.com
MGP_ORACLE_TOKEN=your-oracle-token

# ─── Microsoft Clarity — project ID from https://clarity.microsoft.com/
NEXT_PUBLIC_CLARITY_PROJECT_ID=your-clarity-project-id

# ─── Google Analytics 4 — measurement ID from GA admin ──────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Feature Flags ──────────────────────────────────────────
NEXT_PUBLIC_USE_STATIC_REFERENCE=true

# Reseñas fake en memoria (sin Supabase, sin login real) para probar la UI
# de /recorrido en dev. Nunca se activa en producción aunque quede en true.
NEXT_PUBLIC_MOCK_REVIEWS=false

# ─── API URLs ───────────────────────────────────────────────
NEXT_PUBLIC_CUANDO_API_URL=https://bondi.example.com
NEXT_PUBLIC_PROXY_API_URL=https://proxy.example.com
NEXT_PUBLIC_BONDI_API_URL=https://bondi.example.com

# ─── Push Notifications (VAPID) ─────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC=your-vapid-public-key

# ─── MGP Crypto ─────────────────────────────────────────────
MGP_RSA_PUBKEY=your-rsa-public-key
MGP_SHARED_KEY=your-shared-key

# ─── OSRM Routing ───────────────────────────────────────────
OSRM_URL=https://osrm.example.com